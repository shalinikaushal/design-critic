{
  "name": "design-critic",
  "version": "0.1.0",
  "description": "A portable, provider-independent AI skill that reviews digital product designs like a Principal Product Designer.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test .cline/skills/design-critic/scripts/tests/scoring.test.mjs .cline/skills/design-critic/scripts/tests/checks.test.mjs .cline/skills/design-critic/scripts/tests/dimensions.test.mjs .cline/skills/design-critic/scripts/tests/compat-v01.test.mjs",
    "validate": "node .cline/skills/design-critic/scripts/validate-review.mjs .cline/skills/design-critic/examples",
    "validate:skill": "node .cline/skills/design-critic/scripts/check-skill.mjs",
    "annotations": "node .cline/skills/design-critic/scripts/check-annotations.mjs .cline/skills/design-critic/examples",
    "eval": "node .cline/skills/design-critic/scripts/run-evals.mjs",
    "render": "node .cline/skills/design-critic/scripts/render-report.mjs",
    "score": "node .cline/skills/design-critic/scripts/compute-score.mjs",
    "compat": "node .cline/skills/design-critic/scripts/check-compat.mjs --tag v0.1.0",
    "check": "npm run validate:skill && npm test && npm run validate && npm run annotations && npm run eval && npm run compat"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  }
}

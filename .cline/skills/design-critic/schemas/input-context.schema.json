{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-critic.dev/schemas/input-context.schema.json",
  "title": "Review input context",
  "description": "Normalized description of what was reviewed. Future adapters (Figma plugin, web app) should emit this shape.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources", "platform", "product_domain", "screens"],
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["screenshot", "figma", "prototype", "journey", "web"] }
    },
    "platform": { "enum": ["web", "ios", "android", "mobile_web", "desktop_app", "responsive", "other"] },
    "product_domain": { "type": "string", "minLength": 2, "description": "For example fintech, e-commerce, saas, mobile." },
    "audience": { "type": "string" },
    "goals": {
      "type": "array",
      "items": { "type": "string", "minLength": 5 },
      "description": "Business and user goals as stated by the requester. Absent goals lower score confidence."
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "width", "height"],
        "properties": {
          "id": { "$ref": "https://design-critic.dev/schemas/common.schema.json#/$defs/screenId" },
          "name": { "type": "string", "minLength": 2 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" },
          "heading": { "type": "string", "minLength": 1, "maxLength": 120, "description": "0.2.0 only. The visible page or screen title, copied as shown. Used to compare navigation labels with destinations." },
          "navigation": {
            "type": "array",
            "maxItems": 40,
            "description": "0.2.0 only. Navigation items visible on this screen, transcribed as shown (labels are copied, not paraphrased).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "level"],
              "properties": {
                "label": { "type": "string", "minLength": 1, "maxLength": 80 },
                "level": { "type": "integer", "minimum": 1, "maximum": 4, "description": "1 = primary navigation, 2 = secondary, and so on." },
                "selected": { "type": "boolean", "description": "True when the screen shows this item as the current location." },
                "destination": { "$ref": "https://design-critic.dev/schemas/common.schema.json#/$defs/screenId", "description": "Screen this item leads to, when known from the supplied material." }
              }
            }
          },
          "image": {
            "type": "object",
            "description": "0.2.0 only. Reference to the screenshot file, copied from the ingest manifest (never estimated).",
            "additionalProperties": false,
            "required": ["file", "sha256", "format", "width_px", "height_px"],
            "properties": {
              "file": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9._/-]+\\.(png|jpg|jpeg)$", "maxLength": 200 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "format": { "enum": ["png", "jpeg"] },
              "width_px": { "type": "integer", "minimum": 1, "maximum": 8192 },
              "height_px": { "type": "integer", "minimum": 1, "maximum": 8192 }
            }
          }
        }
      }
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "steps"],
      "properties": {
        "name": { "type": "string" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["screen_id", "action"],
            "properties": {
              "screen_id": { "$ref": "https://design-critic.dev/schemas/common.schema.json#/$defs/screenId" },
              "action": { "type": "string" },
              "outcome": { "type": "string" }
            }
          }
        },
        "transitions": {
          "type": "array",
          "description": "0.2.0 only. Moves between journey screens, in order.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "trigger"],
            "properties": {
              "from": { "$ref": "https://design-critic.dev/schemas/common.schema.json#/$defs/screenId" },
              "to": { "$ref": "https://design-critic.dev/schemas/common.schema.json#/$defs/screenId" },
              "trigger": { "type": "string", "minLength": 3, "description": "What the user does to move, as visible in the screens." },
              "expected": { "type": "string", "description": "What the user would expect to happen." },
              "observed": { "type": "string", "description": "What the next screen actually shows." }
            }
          }
        }
      }
    },
    "design_context": {
      "type": "object",
      "description": "Free-form structured data from a design tool (frames, text styles, colours, tokens, component names, variants). Adapter-defined; not interpreted by the validator."
    }
  }
}

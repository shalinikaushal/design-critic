{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-critic.dev/schemas/annotation.schema.json",
  "title": "Screenshot annotation",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "screen_id", "finding_id", "bbox", "label", "precision"],
  "properties": {
    "id": { "$ref": "https://design-critic.dev/schemas/common.schema.json#/$defs/annotationId" },
    "screen_id": { "$ref": "https://design-critic.dev/schemas/common.schema.json#/$defs/screenId" },
    "finding_id": { "$ref": "https://design-critic.dev/schemas/common.schema.json#/$defs/findingId" },
    "bbox": { "$ref": "https://design-critic.dev/schemas/common.schema.json#/$defs/normalizedBox" },
    "pixel_bbox": {
      "type": "object",
      "description": "Optional. Pixel box derived from bbox and the screen size. Must agree with bbox within 2px.",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "label": { "type": "string", "minLength": 3, "maxLength": 80 },
    "precision": {
      "enum": ["exact", "approximate"],
      "description": "'exact' only when derived from design-tool geometry or pixel measurement; otherwise 'approximate'."
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-critic.dev/schemas/review.schema.json",
  "title": "Design Critic review (root output contract)",
  "description": "Versioned contract produced by the design-critic skill. Markdown reports are rendered from this JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "meta", "input_context", "coverage", "executive_summary",
    "findings", "assumptions", "open_questions", "scorecard", "annotations",
    "concepts", "redesign_specs", "limitations", "wcag_conformance_verified"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "0.1.0" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "scope", "created"],
      "properties": {
        "title": { "type": "string", "minLength": 5 },
        "scope": { "type": "string", "minLength": 10 },
        "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "input_context": { "$ref": "https://design-critic.dev/schemas/input-context.schema.json" },
    "coverage": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "description": "One entry per dimension stating whether the supplied input allowed it to be assessed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "assessed"],
        "properties": {
          "dimension": { "$ref": "https://design-critic.dev/schemas/common.schema.json#/$defs/dimension" },
          "assessed": { "type": "boolean" },
          "limitation": { "type": "string", "description": "What the input could not support. Required when assessed is false." }
        },
        "if": { "properties": { "assessed": { "const": false } }, "required": ["assessed"] },
        "then": { "required": ["limitation"], "properties": { "limitation": { "minLength": 10 } } }
      }
    },
    "executive_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "top_finding_ids", "strengths"],
      "properties": {
        "verdict": { "type": "string", "minLength": 40 },
        "top_finding_ids": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "https://design-critic.dev/schemas/common.schema.json#/$defs/findingId" }
        },
        "strengths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 15 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "https://design-critic.dev/schemas/finding.schema.json" }
    },
    "assumptions": { "type": "array", "items": { "type": "string", "minLength": 10 } },
    "open_questions": { "type": "array", "items": { "type": "string", "minLength": 10 } },
    "scorecard": { "$ref": "https://design-critic.dev/schemas/scorecard.schema.json" },
    "annotations": {
      "type": "array",
      "items": { "$ref": "https://design-critic.dev/schemas/annotation.schema.json" }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "finding_ids", "title", "description", "tradeoffs", "expected_impact"],
        "properties": {
          "id": { "$ref": "https://design-critic.dev/schemas/common.schema.json#/$defs/conceptId" },
          "finding_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "https://design-critic.dev/schemas/common.schema.json#/$defs/findingId" }
          },
          "title": { "type": "string", "minLength": 5 },
          "description": { "type": "string", "minLength": 30 },
          "tradeoffs": { "type": "string", "minLength": 15 },
          "expected_impact": { "type": "string", "minLength": 15 }
        }
      }
    },
    "redesign_specs": {
      "type": "array",
      "items": { "$ref": "https://design-critic.dev/schemas/redesign-spec.schema.json" }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
    "wcag_conformance_verified": {
      "const": false,
      "description": "Always false. WCAG conformance cannot be established from screenshots or design files alone."
    }
  }
}

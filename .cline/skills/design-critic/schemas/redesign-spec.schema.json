{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-critic.dev/schemas/redesign-spec.schema.json",
  "title": "Redesign specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "finding_ids", "title", "screen_id", "summary", "layout", "components", "acceptance_criteria"],
  "properties": {
    "id": { "$ref": "https://design-critic.dev/schemas/common.schema.json#/$defs/specId" },
    "finding_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://design-critic.dev/schemas/common.schema.json#/$defs/findingId" }
    },
    "title": { "type": "string", "minLength": 5 },
    "screen_id": { "$ref": "https://design-critic.dev/schemas/common.schema.json#/$defs/screenId" },
    "summary": { "type": "string", "minLength": 20 },
    "layout": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "change"],
        "properties": {
          "name": { "type": "string", "minLength": 2 },
          "change": { "type": "string", "minLength": 5 },
          "notes": { "type": "string" }
        }
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "purpose"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" },
          "purpose": { "type": "string" }
        }
      }
    },
    "copy": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["element", "proposed"],
        "properties": {
          "element": { "type": "string" },
          "current": { "type": "string" },
          "proposed": { "type": "string" }
        }
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "behaviour"],
        "properties": {
          "name": { "type": "string" },
          "behaviour": { "type": "string" }
        }
      }
    },
    "responsive_notes": { "type": "array", "items": { "type": "string" } },
    "accessibility_notes": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 10 }
    }
  }
}

[
  { "id": "mut-wcag-claim", "kind": "mutation", "category": "no-wcag-claims", "description": "A verdict claiming WCAG AA compliance must be rejected.", "base": "../examples/fintech/review.json",
    "mutations": [{ "op": "set", "path": "executive_summary.verdict", "value": "The flow is clear and the design is WCAG AA compliant, so it is ready to ship once the fee is moved up." }],
    "expect_errors": ["wcag conformance claim"] },
  { "id": "mut-conformance-flag", "kind": "mutation", "category": "no-wcag-claims", "description": "wcag_conformance_verified must stay false.", "base": "../examples/fintech/review.json",
    "mutations": [{ "op": "set", "path": "wcag_conformance_verified", "value": true }],
    "expect_errors": ["schema"] },
  { "id": "mut-generic-advice", "kind": "mutation", "category": "no-generic-critique", "description": "Generic advice such as 'improve the user experience' must be rejected.", "base": "../examples/fintech/review.json",
    "mutations": [{ "op": "set", "path": "findings.0.recommendation", "value": "Improve the overall user experience of this screen so it feels better." }],
    "expect_errors": ["generic phrasing"] },
  { "id": "mut-no-evidence", "kind": "mutation", "category": "evidence", "description": "A finding without evidence must be rejected.", "base": "../examples/fintech/review.json",
    "mutations": [{ "op": "set", "path": "findings.0.evidence", "value": [] }],
    "expect_errors": ["schema"] },
  { "id": "mut-assumption-high-confidence", "kind": "mutation", "category": "assumptions", "description": "An assumption cannot carry high confidence.", "base": "../examples/fintech/review.json",
    "mutations": [{ "op": "set", "path": "findings.0.basis", "value": "assumption" }],
    "expect_errors": ["schema"] },
  { "id": "mut-unknown-screen", "kind": "mutation", "category": "evidence", "description": "Evidence pointing at a screen that was never supplied must be rejected.", "base": "../examples/fintech/review.json",
    "mutations": [{ "op": "set", "path": "findings.0.evidence.0.screen_id", "value": "ghost-screen" }],
    "expect_errors": ["unknown screen"] },
  { "id": "mut-unassessed-dimension-finding", "kind": "mutation", "category": "input-limits", "description": "A finding in a dimension marked not assessed must be rejected.", "base": "../examples/fintech/review.json",
    "mutations": [{ "op": "set", "path": "findings.0.dimension", "value": "information_architecture" }],
    "expect_errors": ["not assessed"] },
  { "id": "mut-static-keyboard-observed", "kind": "mutation", "category": "input-limits", "description": "Keyboard behaviour cannot be 'observed' from a screenshot.", "base": "../examples/ecommerce/review.json",
    "mutations": [{ "op": "set", "path": "findings.0.title", "value": "Keyboard tab order skips the Confirm button on the review screen" }],
    "expect_errors": ["static screenshot"] },
  { "id": "mut-unmarked-measurement", "kind": "mutation", "category": "evidence", "description": "A measurement from a screenshot must be labelled as an estimate.", "base": "../examples/fintech/review.json",
    "mutations": [{ "op": "set", "path": "findings.1.evidence.0.measurement", "value": "2.8:1 contrast" }],
    "expect_errors": ["marked as an estimate"] },
  { "id": "mut-tampered-score", "kind": "mutation", "category": "scoring", "description": "A hand-edited overall score must be caught.", "base": "../examples/fintech/review.json",
    "mutations": [{ "op": "set", "path": "scorecard.overall", "value": 99 }],
    "expect_errors": ["does not match recomputation"] },
  { "id": "mut-annotation-out-of-bounds", "kind": "mutation", "category": "annotations", "description": "Annotation boxes must stay inside the screen.", "base": "../examples/fintech/review.json",
    "mutations": [{ "op": "set", "path": "annotations.0.bbox.x", "value": 0.9 }],
    "expect_errors": ["beyond the right edge"] },
  { "id": "mut-exact-without-geometry", "kind": "mutation", "category": "annotations", "description": "'exact' precision needs design-tool or web geometry.", "base": "../examples/fintech/review.json",
    "mutations": [{ "op": "set", "path": "annotations.0.precision", "value": "exact" }],
    "expect_errors": ["exact precision"] },
  { "id": "mut-assumption-major", "kind": "mutation", "category": "assumptions", "description": "An assumption-based finding cannot be rated major.", "base": "../examples/fintech/review.json",
    "mutations": [{ "op": "set", "path": "findings.0.basis", "value": "assumption" }, { "op": "set", "path": "findings.0.confidence", "value": "low" }, { "op": "rescore" }],
    "expect_errors": ["cannot be critical or major"] }
]
